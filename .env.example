# Public HTTPS URL used by Telegram buttons and PayPal redirects
NEXT_PUBLIC_APP_URL=https://circles.wanderwrap.co.uk

# Telegram bot configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# PayPal REST credentials. Use sandbox values for development.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_OAUTH_STATE_SECRET=
TELEGRAM_BOT_USERNAME=

# Amazon Bedrock. App Runner uses its IAM role; do not add static AWS keys.
# Nova 2 Lite is fast and cost-conscious for orchestration. Swap the profile after evaluation.
AWS_REGION=eu-west-2
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
# Optional Bedrock Guardrail applied to every specialist call.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Local development only. Never enable in the deployed environment.
ALLOW_DEMO_AUTH=false

# AWS single-table persistence. Leave blank for local in-memory demo mode.
DYNAMODB_TABLE=
